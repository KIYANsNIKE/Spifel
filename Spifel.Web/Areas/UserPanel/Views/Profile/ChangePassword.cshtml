@model Spifel.Web.Areas.UserPanel.Feature.Profile.ChangePassword.ChangePasswordVM

@{
    ViewData["Title"] = "Change Password";

}
<div class="row">
    <div class="col-lg-6">
        <div class="ui-box bg-white mb-5">
            <div class="ui-box-content">
                <div class="ui-box-title">بازیابی رمز عبور</div>
                <!-- start of auth-box -->
                <div class="auth-box ui-box">
                    <!-- start of auth-form -->
                    <form asp-area="UserPanel" asp-controller="Profile" asp-action="ChangePassword" class="auth-form">
                        <!-- start of form-element -->
                        <div class="form-element-row mb-3">
                            <input asp-for="OldPassword" class="form-control" placeholder="رمز عبور فعلی">
                            <span asp-validation-for="OldPassword" class="text-danger"></span>
                        </div>
                        <div class="form-element-row mb-3">
                            <input asp-for="Password" class="form-control" placeholder="رمز عبور جدید">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <!-- end of form-element -->
                        <!-- start of form-element -->
                        <div class="form-element-row mb-3">
                            <input asp-for="RePassword" class="form-control" placeholder="تکرار رمز عبور جدید">
                            <span asp-validation-for="RePassword" class="text-danger"></span>
                        </div>
                        <div class="form-element-row mb-3">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                        <!-- end of form-element -->
                        <!-- start of form-element -->
                        <div class="form-element-row">
                            <button class="btn btn-primary">بازیابی رمز عبور</button>
                        </div>
                        <!-- end of form-element -->
                    </form>
                    <!-- end of auth-form -->
                </div>
                <!-- end of auth-box -->

                
            </div>
        </div>
    </div>

</div>


@if (TempData["PasswordChanged"] != null)
{
    @section Scripts {

        <script>
            Swal.fire({
                icon: 'success',
                title: 'رمز عبور شما با موفقیت تغییر کرد',
                html: `
                    <p>لطفاً مجدداً وارد سایت شوید.</p>
                    <p>چند ثانیه دیگر به صورت خودکار از حساب کاربری خارج خواهید شد.</p>
                `,
                confirmButtonText: 'ورود مجدد',
                confirmButtonColor: '#3085d6',

                timer: 5000,
                timerProgressBar: true,

                allowOutsideClick: false,
                allowEscapeKey: false,
                allowEnterKey: false,
                showCloseButton: false,
                stopKeydownPropagation: true

            }).then(() => {

                window.location.href = '/Logout';

            });
        </script>
    }
}