@model bool

@if (Model == false)
{
    <div class="alert alert-warning alert-dismissible fade show mb-5" role="alert">
        <div>
            برای استفاده از تمامی امکانات سایت پروفایل خود را تکمیل کنید 
            <a asp-area="UserPanel" asp-controller="Profile" asp-action="PersonalInfo" class="btn btn-sm btn-primary mx-3">تکمیل پروفایل</a>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}