@model Spifel.Web.Areas.UserPanel.Feature.Profile.PersonalInfo.PersonalInfoVM

<div class="col-lg-3 mb-4">
    <div class="border rounded-4 p-2 text-center shadow-sm h-100">
        @* Change Avatar form *@
        <form method="post"
              asp-area="UserPanel"
              asp-controller="Profile"
              asp-action="ChangeAvatar"
              enctype="multipart/form-data"
              id="avatarForm">

            <div class="position-relative d-inline-block">

                <!-- Avatar -->
                <img id="avatarPreview"
                     src="/Profiles/@Model.Avatar"
                     class="rounded-circle border"
                     style="width:140px;height:140px;object-fit:cover;">

                <!-- File input -->
                <input id="avatarFile"
                       asp-for="AvatarFile"
                       type="file"
                       accept="image/*"
                       hidden>

                <!-- انتخاب عکس -->
                <label for="avatarFile"
                       class="btn btn-outline-light btn-sm rounded-circle position-absolute bottom-0 end-0"
                       style="width:38px;height:38px;"
                       title="انتخاب تصویر">

                    <i class="ri-camera-fill"></i>
                </label>

                <!-- لغو انتخاب / حذف عکس -->
                <button type="button"
                        id="avatarCancelButton"
                        class="btn btn-outline-light btn-sm rounded-circle position-absolute top-0 end-0"
                        style="width:38px;height:38px;"
                        title="حذف تصویر">

                    <i id="avatarCancelIcon" class="ri-delete-bin-fill"></i>

                </button>
                <!-- ثبت عکس جدید -->
                <button type="submit"
                        id="avatarSubmitButton"
                        class="btn btn-outline-light btn-sm rounded-circle position-absolute top-0 start-0 d-none"
                        style="width:38px;height:38px;"
                        title="ثبت تصویر">

                    <i class="ri-check-fill"></i>
                </button>

            </div>

        </form>

        @* Delete Avatar form *@
        <form method="post"
              asp-area="UserPanel"
              asp-controller="Profile"
              asp-action="DeleteAvatar"
              id="deleteAvatarForm">

            @Html.AntiForgeryToken()

        </form>

        <h6 class="fw-bold mt-3 mb-1">
            تصویر پروفایل
        </h6>

    </div>
</div>
