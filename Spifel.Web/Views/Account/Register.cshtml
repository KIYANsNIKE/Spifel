@model Spifel.Web.Feature.Account.Register.RegisterVM
@{
    ViewData["Title"] = "ثبت نام";
}
<!-- start of auth-container -->
<div class="auth-container">
    <div class="auth-title mb-3">ثبت نام</div>
    <!-- start of auth-box -->
    <div class="auth-box ui-box">
        <!-- start of auth-form -->
        <form asp-action="Register" class="auth-form">
            <!-- start of form-element -->
            <div class="form-element-row mb-2">
                <input asp-for="UserName" class="form-control" placeholder="نام کاربری">
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="form-element-row mb-2">
                <input asp-for="Email" class="form-control" placeholder="ایمیل" style="direction:rtl">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-element-row mb-2">
                <input asp-for="Password" class="form-control" placeholder="کلمه عبور">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-element-row mb-2">
                <input asp-for="RePassword" class="form-control" placeholder="تکرار کلمه عبور">
                <span asp-validation-for="RePassword" class="text-danger"></span>
            </div>

            <div class="form-element-row mb-3">
                <button class="btn btn-primary">ثبت</button>
            </div>

            <div class="form-element-row">
                <div>
                    با ثبت نام در سایت شما 
                    <a href="#" class="link">شرایط و قوانین</a>
                    استفاده از تمام سرویس های سایت و 
                    <a href="#" class="link">قوانین حریم خصوصی</a>
                    آن را می‌پذیرید.
                </div>
             </div>
            <!-- end of form-element -->
        </form>
        <!-- end of auth-form -->
    </div>
    <!-- end of auth-box -->
</div>
<!-- start of auth-container -->
