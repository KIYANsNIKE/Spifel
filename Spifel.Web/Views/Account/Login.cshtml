@model Spifel.Web.Feature.Account.Login.LoginVM
@{
    ViewData["Title"] = "ورود به سایت";
}
<!-- start of auth-container -->
<div class="auth-container">
    <div class="auth-title mb-3">ورود</div>
    <!-- start of auth-box -->
    <div class="auth-box ui-box">
        <!-- start of auth-form -->
        <form asp-action="Login" class="auth-form">
            <!-- start of form-element -->
            <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl" />
            <div class="form-element-row mb-2">
                <input asp-for="UserNameOrEmail" class="form-control" placeholder=" نام کاربری یا ایمیل">
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>
            <div class="form-element-row mb-2">
                <input asp-for="Password" type="password" class="form-control" placeholder="کلمه عبور">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="widget-content widget--filter-switcher">
                <div class="form-check form-switch mb-0">
                    <input asp-for="RememberMe" class="form-check-input" >
                    <label class="form-check-label">
                        منو یادت باشه
                    </label>
                </div>
            </div>
            <div class="form-element-row mb-2">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
            @if (Model != null && Model.IsUserNotActive)
            {
                <div class="alert alert-danger">
                    <p>اکانت فعال نیست</p>
                </div>
            }

            <div class="form-element-row mb-3">
                <button class="btn btn-primary">ورود</button>
            </div>

            <div class="form-element-row">
                <div>
                    <a href="#" class="link">فراموشی رمز عبور</a>
                    |
                    <a href="#" class="link">ورود با کد یکبار مصرف</a>
                </div>
            </div>
            <!-- end of form-element -->
        </form>
        <!-- end of auth-form -->
    </div>
    <!-- end of auth-box -->
</div>
<!-- start of auth-container -->
